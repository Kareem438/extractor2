"""
Sequential OCR Service

Implements user-controlled sequential OCR processing with:
- PaddleOCR (GPU)
- Surya OCR (GPU)
- Tesseract (CPU)
- Evaluation/Split/Mark pipeline

Aligned with sequential-ocr-svg-processing.md architecture.
"""

from typing import Dict, Any
from sqlalchemy import text
from src.database.connection import SessionLocal
from src.utils.logging_config import logger
from src.services.gpu_manager import gpu_manager
from src.services.image_analyzer import get_image_analyzer
from src.services.svg_generator import generate_svg_from_json


async def run_paddleocr_sequential(book_id: int):
    """
    Extract text from PDF pages using PyMuPDF.

    Process:
    1. Get PDF file path from book metadata
    2. For each page:
       - Extract text using PyMuPDF
       - Store text in attr2_value, confidence in attr5_value
       - If FIRST OCR run: Extract and analyze images
    3. Mark paddleocr_complete = true

    Args:
        book_id: Book ID to process
    """
    import fitz  # PyMuPDF

    logger.info(f"Starting text extraction for book_id={book_id}")

    db = SessionLocal()
    try:
        # Get book metadata including file path
        result = db.execute(
            text("SELECT table_prefix, total_pages, file_path FROM books_metadata WHERE book_id = :book_id"),
            {"book_id": book_id}
        ).first()

        if not result:
            raise ValueError(f"Book {book_id} not found")

        table_prefix, total_pages, pdf_path = result

        if not pdf_path:
            raise ValueError(f"No file path found for book {book_id}")

        # Check if this is the first OCR run (images not processed yet)
        state = db.execute(
            text(f"SELECT images_processed FROM {table_prefix}_processing_state WHERE id = 1")
        ).first()
        is_first_ocr = not state[0] if state else True

        logger.info(f"Extracting text from {total_pages} pages (first run: {is_first_ocr})")
        logger.info(f"PDF path: {pdf_path}")

        # Open PDF
        pdf_doc = fitz.open(pdf_path)

        for page_num in range(1, total_pages + 1):
            logger.info(f"Processing page {page_num}/{total_pages}")

            # Get page (fitz uses 0-based indexing)
            page = pdf_doc[page_num - 1]

            # Extract text
            page_text = page.get_text("text")

            # Calculate confidence (100% for direct text extraction, 95% if text is sparse)
            text_length = len(page_text.strip())
            confidence = "100.0" if text_length > 50 else "95.0"

            # Store in knowledge_units (attr2_value, attr5_value)
            db.execute(
                text(f"""
                INSERT INTO {table_prefix}_knowledge_units
                (page_number, text_content, attr2_value, attr5_value)
                VALUES (:page_num, '', :ocr_text, :confidence)
                """),
                {"page_num": page_num, "ocr_text": page_text, "confidence": confidence}
            )

            # If first OCR run: Extract images
            if is_first_ocr:
                image_list = page.get_images()
                if image_list:
                    logger.info(f"Page {page_num}: Found {len(image_list)} images")
                    for img_index, img in enumerate(image_list):
                        try:
                            xref = img[0]
                            base_image = pdf_doc.extract_image(xref)
                            image_bytes = base_image["image"]
                            image_ext = base_image["ext"]

                            # Store image in images table
                            db.execute(
                                text(f"""
                                INSERT INTO {table_prefix}_images
                                (image_identifier, page_number, image_data, image_type, analyzed_during_ocr)
                                VALUES (:id, :page, :data, :type, 'pymupdf')
                                """),
                                {
                                    "id": f"IMG-{book_id}-P{page_num}-{img_index}",
                                    "page": page_num,
                                    "data": image_bytes,
                                    "type": image_ext.upper()
                                }
                            )
                            logger.info(f"Extracted image {img_index} from page {page_num}")
                        except Exception as img_error:
                            logger.warning(f"Failed to extract image {img_index} from page {page_num}: {img_error}")

            # Update progress every 10 pages
            if page_num % 10 == 0:
                db.execute(
                    text(f"UPDATE {table_prefix}_processing_state SET current_page = :page WHERE id = 1"),
                    {"page": page_num}
                )
                db.commit()

        # Close PDF
        pdf_doc.close()

        # Mark PaddleOCR complete
        db.execute(
            text(f"""
            UPDATE {table_prefix}_processing_state
            SET paddleocr_complete = true, images_processed = :first_ocr, current_agent = 'pymupdf'
            WHERE id = 1
            """),
            {"first_ocr": is_first_ocr}
        )
        db.commit()

        logger.info(f"Text extraction complete for book_id={book_id}")

    except Exception as e:
        logger.error(f"Text extraction failed for book_id={book_id}: {e}")
        raise
    finally:
        db.close()


