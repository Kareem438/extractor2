    }
}

/**
 * Load knowledge units for the current page (for linking dropdown)
 */
async function loadKnowledgeUnitsForLinking() {
    if (!currentBookId || !currentPage) {
        console.error('Missing book ID or page number');
        return;
    }

    const linkSelect = document.getElementById('link-to-ku-select');

    try {
        const response = await fetch(`/api/diagrams/${currentBookId}/knowledge-units-for-page/${currentPage}`);

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();
        pageKnowledgeUnits = result.knowledge_units || [];

        // Clear existing options (except first two)
        while (linkSelect.options.length > 2) {
            linkSelect.remove(2);
        }

        // Add knowledge units as options
        pageKnowledgeUnits.forEach(ku => {
            const option = document.createElement('option');
            option.value = ku.unit_id;
            option.textContent = `${ku.is_paragraph ? '📝' : '📄'} KU #${ku.unit_id}: ${ku.text_preview}`;
            option.dataset.preview = ku.text_preview;
            linkSelect.appendChild(option);
        });

        console.log(`Loaded ${pageKnowledgeUnits.length} knowledge units for linking`);

    } catch (error) {
        console.error('Error loading knowledge units for linking:', error);
    }
}

/**
 * Handle link selection change
 */
function onLinkSelectionChanged() {
    const linkSelect = document.getElementById('link-to-ku-select');
    const linkPreview = document.getElementById('link-preview');
    const btnSaveLink = document.getElementById('btn-save-link');

    const selectedValue = linkSelect.value;

    if (selectedValue === '' || selectedValue === 'none') {
        linkPreview.textContent = selectedValue === 'none'
            ? 'Diagram will be standalone (no link)'
            : 'Select a knowledge unit to see preview';
        btnSaveLink.disabled = selectedValue === '';
    } else {
        // Find the selected option and show preview
        const selectedOption = linkSelect.options[linkSelect.selectedIndex];
        linkPreview.textContent = selectedOption.dataset.preview || 'No preview available';
        btnSaveLink.disabled = false;
    }
}

/**
 * Save the diagram link to a knowledge unit
 */
async function saveDiagramLink() {
    if (!currentDiagramId || !currentBookId) {
        console.error('No diagram ID to link');
        return;
    }

    const linkSelect = document.getElementById('link-to-ku-select');
    const btnSaveLink = document.getElementById('btn-save-link');

    const selectedValue = linkSelect.value;
    const knowledgeUnitId = selectedValue === 'none' ? null : (selectedValue ? parseInt(selectedValue) : null);

    try {
        btnSaveLink.disabled = true;
        btnSaveLink.textContent = 'Saving...';

        const response = await fetch('/api/diagrams/save-link', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                book_id: currentBookId,
                diagram_id: currentDiagramId,
                knowledge_unit_id: knowledgeUnitId
            })
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log('Diagram link saved:', result);

        btnSaveLink.textContent = '✓ Link Saved';
        setTimeout(() => {
            btnSaveLink.textContent = '💾 Save Link';
            btnSaveLink.disabled = false;
        }, 2000);

    } catch (error) {
        console.error('Error saving diagram link:', error);
        btnSaveLink.textContent = '✗ Save Failed';
        setTimeout(() => {
            btnSaveLink.textContent = '💾 Save Link';
            btnSaveLink.disabled = false;
        }, 2000);
    }
}

/**
 * Reset diagram analysis sections
 */
function resetDiagramSections() {
    const diagramAnalysisSection = document.getElementById('diagram-analysis-section');
    const diagramLinkingSection = document.getElementById('diagram-linking-section');
    const diagramDescriptionArea = document.getElementById('diagram-description-area');
    const diagramStatus = document.getElementById('diagram-analysis-status');
    const diagramTypeBadge = document.getElementById('diagram-type-badge');
    const diagramSaveStatus = document.getElementById('diagram-save-status');
    const btnSaveDiagram = document.getElementById('btn-save-diagram');
    const linkSelect = document.getElementById('link-to-ku-select');
    const linkPreview = document.getElementById('link-preview');
    const btnSaveLink = document.getElementById('btn-save-link');

    if (diagramAnalysisSection) {
        diagramAnalysisSection.classList.remove('visible');
    }
    if (diagramLinkingSection) {
        diagramLinkingSection.classList.remove('visible');
    }
    if (diagramDescriptionArea) {
        diagramDescriptionArea.value = '';
        diagramDescriptionArea.disabled = true;
    }
    if (diagramStatus) {
        diagramStatus.textContent = 'Ready';
        diagramStatus.classList.remove('processing', 'error');
    }
    if (diagramTypeBadge) {
        diagramTypeBadge.textContent = 'Type: --';
    }
    if (diagramSaveStatus) {
        diagramSaveStatus.textContent = '';
    }
    if (btnSaveDiagram) {
        btnSaveDiagram.disabled = true;
    }
    if (linkSelect) {
        linkSelect.selectedIndex = 0;
    }
    if (linkPreview) {
        linkPreview.textContent = 'Select a knowledge unit to see preview';
    }
    if (btnSaveLink) {
        btnSaveLink.disabled = true;
    }

    currentDiagramResult = null;
    currentDiagramId = null;
    currentDiagramKuId = null;
    diagramDescriptionModified = false;
    pageKnowledgeUnits = [];

    // Also reset V3 diagram details section
    resetDiagramDetailsSection();
}

// ============================================================================
// Diagram Details V3 Functions
// ============================================================================

/**
 * Show the diagram details section with the cropped image
 * Called after diagram analysis completes
 */
function showDiagramDetailsSection(imageData, analysisResult) {
    const section = document.getElementById('diagram-details-section');
    const previewImage = document.getElementById('diagram-preview-image');
    const previewInfo = document.getElementById('diagram-preview-info');
    const aiTextarea = document.getElementById('diagram-ai-textarea');
    const aiStatusBadge = document.getElementById('diagram-ai-status-badge');

    if (!section) return;

    // Store image data for OCR operations
    diagramImageData = imageData;

    // Show the section
    section.classList.add('visible');

    // Set preview image
    if (previewImage) {
        previewImage.src = imageData;
    }

    // Set preview info
    if (previewInfo && currentSelectionScaled) {
        previewInfo.innerHTML = `
            <div>Size: ${currentSelectionScaled.width} x ${currentSelectionScaled.height} px</div>
            <div>Format: PNG</div>
            <div>Page: ${currentPage}</div>
        `;
    }

    // Set AI analysis result
    if (aiTextarea && analysisResult) {
        aiTextarea.value = analysisResult.description || '';
    }

    // Update AI status
    if (aiStatusBadge) {
        aiStatusBadge.textContent = analysisResult ? '✓ Complete' : 'Ready';
        aiStatusBadge.classList.remove('processing', 'error');
    }

    // Load KU list for associated text section
    loadKUsForDiagramDetails();

    // Reset selected KU
    selectedDiagramKuId = null;
    updateAssociatedTextDisplay();

    console.log('Diagram details section shown');
}

/**
 * Reset the diagram details section
 */
function resetDiagramDetailsSection() {
    const section = document.getElementById('diagram-details-section');
    const previewImage = document.getElementById('diagram-preview-image');
    const previewInfo = document.getElementById('diagram-preview-info');
    const aiTextarea = document.getElementById('diagram-ai-textarea');
    const aiStatusBadge = document.getElementById('diagram-ai-status-badge');
    const associatedDisplay = document.getElementById('diagram-associated-display');
    const kuListSection = document.getElementById('diagram-ku-list-section');

    if (section) {
        section.classList.remove('visible');
    }
    if (previewImage) {
        previewImage.src = '';
    }
    if (previewInfo) {
        previewInfo.innerHTML = `
            <div>Size: -- x -- px</div>
            <div>Format: PNG</div>
            <div>Page: --</div>
        `;
    }
    if (aiTextarea) {
        aiTextarea.value = '';
    }
    if (aiStatusBadge) {
        aiStatusBadge.textContent = 'Ready';
        aiStatusBadge.classList.remove('processing', 'error');
    }

    // Reset associated text
    if (associatedDisplay) {
        associatedDisplay.innerHTML = 'Select a knowledge unit from the list below';
        associatedDisplay.classList.remove('has-content');
    }
    if (kuListSection) {
        kuListSection.innerHTML = '<div style="text-align: center; color: #999; padding: 20px; font-style: italic;">Loading knowledge units...</div>';
    }

    // Reset state
    diagramImageData = null;
    selectedDiagramKuId = null;
    diagramLevelTitles = { 1: '', 2: '', 3: '', 4: '', 5: '' };
}

/**
 * Load knowledge units for the diagram details associated text section
 */
async function loadKUsForDiagramDetails() {
    const kuListSection = document.getElementById('diagram-ku-list-section');

    if (!currentBookId || !currentPage) {
        if (kuListSection) {
            kuListSection.innerHTML = '<div style="text-align: center; color: #999; padding: 20px;">No page loaded</div>';
        }
        return;
    }

    try {
        const response = await fetch(`/api/diagrams/${currentBookId}/knowledge-units-for-page/${currentPage}`);

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();
        pageKnowledgeUnits = result.knowledge_units || [];

        if (kuListSection) {
            if (pageKnowledgeUnits.length === 0) {
                kuListSection.innerHTML = '<div style="text-align: center; color: #999; padding: 20px; font-style: italic;">No knowledge units on this page</div>';
            } else {
                kuListSection.innerHTML = pageKnowledgeUnits.map(ku => `
                    <div class="diagram-ku-item ${selectedDiagramKuId === ku.unit_id ? 'selected' : ''}"
                         onclick="selectDiagramKu(${ku.unit_id})"
                         data-ku-id="${ku.unit_id}">
                        <input type="radio" class="diagram-ku-radio" name="diagram-ku"
                               ${selectedDiagramKuId === ku.unit_id ? 'checked' : ''} />
                        <div class="diagram-ku-content">
                            <div class="diagram-ku-id">${ku.is_paragraph ? '📝' : '📄'} KU #${ku.unit_id}</div>
                            <div class="diagram-ku-text">${escapeHtml(ku.text_preview)}</div>
                        </div>
                    </div>
                `).join('');
            }
        }

        console.log(`Loaded ${pageKnowledgeUnits.length} KUs for diagram details`);

    } catch (error) {
        console.error('Error loading KUs for diagram details:', error);
        if (kuListSection) {
            kuListSection.innerHTML = '<div style="text-align: center; color: #f44336; padding: 20px;">Error loading knowledge units</div>';
        }
    }
}

/**
 * Select a knowledge unit for diagram association
 */
function selectDiagramKu(kuId) {
    selectedDiagramKuId = kuId;

    // Update UI - highlight selected item
    const items = document.querySelectorAll('.diagram-ku-item');
    items.forEach(item => {
        const itemKuId = parseInt(item.dataset.kuId);
        if (itemKuId === kuId) {
            item.classList.add('selected');
            item.querySelector('.diagram-ku-radio').checked = true;
        } else {
            item.classList.remove('selected');
            item.querySelector('.diagram-ku-radio').checked = false;
        }
    });

    // Update associated text display
    updateAssociatedTextDisplay();

    console.log(`Selected KU ${kuId} for diagram association`);
}

/**
 * Update the associated text display with selected KU
 */
function updateAssociatedTextDisplay() {
    const display = document.getElementById('diagram-associated-display');
    if (!display) return;

    if (selectedDiagramKuId) {
        const ku = pageKnowledgeUnits.find(k => k.unit_id === selectedDiagramKuId);
        if (ku) {
            display.innerHTML = `
                <span class="diagram-selected-ku-badge">✓ KU #${ku.unit_id} Selected</span>
                <button class="btn-clear-associated" onclick="clearDiagramKuSelection()">✕</button>
                <div style="margin-top: 6px;">"${escapeHtml(ku.text_preview)}"</div>
            `;
            display.classList.add('has-content');
        }
    } else {
        display.innerHTML = 'Select a knowledge unit from the list below';
        display.classList.remove('has-content');
    }
}

/**
 * Clear the selected KU for diagram association
 */
function clearDiagramKuSelection() {
    selectedDiagramKuId = null;

    // Update UI
    const items = document.querySelectorAll('.diagram-ku-item');
    items.forEach(item => {
        item.classList.remove('selected');
        item.querySelector('.diagram-ku-radio').checked = false;
    });

    updateAssociatedTextDisplay();
}

/**
 * Re-analyze the diagram with Claude Vision
 */
async function reanalyzeDiagram() {
    if (!currentDiagramId || !currentBookId) {
        alert('No diagram to analyze');
        return;
    }

    const btn = document.getElementById('btn-reanalyze');
    const textarea = document.getElementById('diagram-ai-textarea');
    const statusBadge = document.getElementById('diagram-ai-status-badge');

    if (btn) {
        btn.textContent = '⏳ Analyzing...';
        btn.disabled = true;
    }
    if (statusBadge) {
        statusBadge.textContent = 'Processing...';
        statusBadge.classList.add('processing');
    }

    try {
        // Get the current diagram image
        const croppedImage = document.getElementById('cropped-image');
        if (!croppedImage) {
            throw new Error('No diagram image available');
        }

        const requestData = {
            book_id: currentBookId,
            page_number: currentPage,
            selection_x: currentSelectionScaled.x,
            selection_y: currentSelectionScaled.y,
            selection_width: currentSelectionScaled.width,
            selection_height: currentSelectionScaled.height,
            image_data_base64: croppedImage.src,
            level: 'Level 1',
            use_claude: true,
            use_surya: true
        };

        const response = await fetch('/api/ocr/analyze-diagram', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(requestData)
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.detail || `HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log('Re-analysis result:', result);

        // Update diagram ID and textarea
        currentDiagramId = result.diagram_id;
        currentDiagramKuId = result.knowledge_unit_id;

        if (textarea) {
            textarea.value = result.description || '';
        }
        if (statusBadge) {
            statusBadge.textContent = '✓ Complete';
            statusBadge.classList.remove('processing', 'error');
        }

    } catch (error) {
        console.error('Re-analysis error:', error);
        if (statusBadge) {
            statusBadge.textContent = 'Error';
            statusBadge.classList.remove('processing');
            statusBadge.classList.add('error');
        }
        alert(`Analysis failed: ${error.message}`);
    } finally {
        if (btn) {
            btn.textContent = '🤖 Re-Analyze';
            btn.disabled = false;
        }
    }
}

/**
 * Cancel diagram details and close the section
 */
function cancelDiagramDetails() {
    resetDiagramDetailsSection();
    clearSelection();
}

/**
 * Save all diagram data including level titles
 */
async function saveDiagramAll() {
    if (!currentDiagramId || !currentBookId) {
        alert('No diagram to save');
        return;
    }

    const saveBtn = document.getElementById('btn-diagram-save-all');
    if (saveBtn) {
        saveBtn.textContent = '⏳ Saving...';
        saveBtn.disabled = true;
    }

    try {
        // Collect level titles from the existing Level Extraction section
        for (let i = 1; i <= 5; i++) {
            const input = document.getElementById(`level-${i}-input`);
            if (input) {
                diagramLevelTitles[i] = input.value.trim();
            }
        }

        // Get selected level info from radio buttons
        const levelInfo = getSelectedLevelInfo();

        // Get AI analysis text
        const aiTextarea = document.getElementById('diagram-ai-textarea');
        const description = aiTextarea ? aiTextarea.value : '';

        // Save all data via API
        const response = await fetch('/api/diagrams/save-all', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                book_id: currentBookId,
                diagram_id: currentDiagramId,
                level_1_title: diagramLevelTitles[1] || null,
                level_2_title: diagramLevelTitles[2] || null,
                level_3_title: diagramLevelTitles[3] || null,
                level_4_title: diagramLevelTitles[4] || null,
                level_5_title: diagramLevelTitles[5] || null,
                linked_knowledge_unit_id: selectedDiagramKuId || null,
                description: description,
                selected_level_number: levelInfo.number,
                selected_level_text: levelInfo.text
            })
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.detail || `HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log('Diagram save result:', result);

        // Show success
        if (saveBtn) {
            saveBtn.textContent = '✓ Saved!';
        }

        // Reload clips gallery
        await loadRecentClips();

        // Reset and close after a brief delay
        setTimeout(() => {
            resetDiagramDetailsSection();
            clearSelection();
        }, 1000);

    } catch (error) {
        console.error('Error saving diagram:', error);
        alert(`Save failed: ${error.message}`);
        if (saveBtn) {
            saveBtn.textContent = '💾 Save All';
            saveBtn.disabled = false;
        }
    }
}

// ============================================================================
// Multi-OCR Comparison Functions
// ============================================================================

// State for multi-OCR comparison
let multiOcrResults = {
    'surya-600': { text: '', confidence: 0, status: 'waiting' },
    'surya-ds': { text: '', confidence: 0, status: 'waiting' },
    'tesseract': { text: '', confidence: 0, status: 'waiting' },
    'easyocr': { text: '', confidence: 0, status: 'waiting' }
};
let selectedOcrEngine = null;
let multiOcrClipId = null; // Clip ID created when saving
let ocrCompletedCount = 0;

/**
 * Run all 4 OCR engines on the current selection
 * Called when user clicks "Add as Paragraph" in OCR mode
 */
async function runMultiOcrComparison() {
    const croppedImage = document.getElementById('cropped-image');
    if (!croppedImage || !currentSelectionScaled || !currentBookId) {
        console.error('Missing required data for OCR');
        return null;
    }

    // Reset state
    multiOcrResults = {
        'surya-600': { text: '', confidence: 0, status: 'waiting' },
        'surya-ds': { text: '', confidence: 0, status: 'waiting' },
        'tesseract': { text: '', confidence: 0, status: 'waiting' },
        'easyocr': { text: '', confidence: 0, status: 'waiting' }
    };
    selectedOcrEngine = null;
    multiOcrClipId = null;
    ocrCompletedCount = 0;

    // Show comparison section
    const comparisonSection = document.getElementById('ocr-comparison-section');
    comparisonSection.classList.add('visible');

    // Reset all OCR boxes
    ['surya-600', 'surya-ds', 'tesseract', 'easyocr'].forEach(engine => {
        updateOcrEngineBox(engine, 'waiting', '', 0);
    });

    // Update progress
    updateOcrProgress(0, 'Starting OCR engines...');

    // Get selected level
    const levelSelect = document.getElementById('level-select');
    const selectedLevel = levelSelect ? levelSelect.value : 'Level 1';

    // Prepare base request data
    const baseRequestData = {
        book_id: currentBookId,
        page_number: currentPage,
        selection_x: currentSelectionScaled.x,
        selection_y: currentSelectionScaled.y,
        selection_width: currentSelectionScaled.width,
        selection_height: currentSelectionScaled.height,
        image_data_base64: croppedImage.src,
        level: selectedLevel
    };

    // Run all 4 OCR engines in parallel
    const ocrPromises = [
        runSingleOcr('surya-600', '/api/ocr/multi-surya-600', baseRequestData),
        runSingleOcr('surya-ds', '/api/ocr/multi-surya-downsampled', baseRequestData),
        runSingleOcr('tesseract', '/api/ocr/multi-tesseract-arabic', baseRequestData),
        runSingleOcr('easyocr', '/api/ocr/multi-easyocr', baseRequestData)
    ];

    // Wait for all to complete
    await Promise.allSettled(ocrPromises);

    // Update progress to complete
    updateOcrProgress(100, 'All OCR engines complete. Select the best result.');

    // Enable save button
    document.getElementById('btn-ocr-save-selected').disabled = false;

    return true;
}

/**
 * Run a single OCR engine
 */
async function runSingleOcr(engineId, endpoint, requestData) {
    updateOcrEngineBox(engineId, 'loading', 'Processing...', 0);

    try {
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(requestData)
        });

        if (!response.ok) {
            const errorData = await response.json().catch(() => ({}));
            throw new Error(errorData.detail || `HTTP ${response.status}`);
        }

        const result = await response.json();

        multiOcrResults[engineId] = {
            text: result.ocr_text || '',
            confidence: result.confidence || 0,
            status: 'ready'
        };

        // Store clip ID if returned (first successful result creates the clip)
        if (result.clip_id && !multiOcrClipId) {
            multiOcrClipId = result.clip_id;
        }

        updateOcrEngineBox(engineId, 'ready', result.ocr_text, result.confidence);

    } catch (error) {
        console.error(`OCR error for ${engineId}:`, error);
        multiOcrResults[engineId] = {
            text: `Error: ${error.message}`,
            confidence: 0,
            status: 'error'
        };
        updateOcrEngineBox(engineId, 'error', `Error: ${error.message}`, 0);
    }

    // Update progress
    ocrCompletedCount++;
    updateOcrProgress(ocrCompletedCount * 25, `${ocrCompletedCount}/4 OCR engines complete...`);
}

/**
 * Update an OCR engine box UI
 */
function updateOcrEngineBox(engineId, status, text, confidence) {
    const badge = document.getElementById(`badge-${engineId}`);
    const textarea = document.getElementById(`text-${engineId}`);
    const confSpan = document.getElementById(`conf-${engineId}`);
    const box = document.getElementById(`ocr-box-${engineId}`);

    if (badge) {
        badge.textContent = status === 'loading' ? 'Processing...' :
                           status === 'ready' ? 'Ready' :
                           status === 'error' ? 'Error' : 'Waiting';
        badge.className = 'ocr-engine-badge ' + status;
    }

    if (textarea) {
        textarea.value = text;
        textarea.disabled = status !== 'ready';
    }

    if (confSpan) {
        if (status === 'ready' && confidence > 0) {
            const confPercent = (confidence * 100).toFixed(1);
            confSpan.textContent = `${confPercent}%`;
            confSpan.className = 'ocr-engine-confidence ' +
                (confidence >= 0.9 ? 'high' : confidence >= 0.7 ? 'medium' : 'low');
        } else {
            confSpan.textContent = '--';
            confSpan.className = 'ocr-engine-confidence';
        }
    }
}

/**
 * Update progress bar
 */
function updateOcrProgress(percent, statusText) {
    const progressFill = document.getElementById('ocr-progress-fill');
    const progressStatus = document.getElementById('ocr-progress-status');

    if (progressFill) {
        progressFill.style.width = `${percent}%`;
    }
    if (progressStatus) {
        progressStatus.textContent = statusText;
    }
}

/**
 * Select an OCR engine (radio button click)
 */
function selectOcrEngine(engineId) {
    selectedOcrEngine = engineId;

    // Update radio buttons
    ['surya-600', 'surya-ds', 'tesseract', 'easyocr'].forEach(id => {
        const radio = document.getElementById(`radio-${id}`);
        const box = document.getElementById(`ocr-box-${id}`);
        if (radio) radio.checked = (id === engineId);
        if (box) {
            box.classList.toggle('selected', id === engineId);
        }
    });

    // Enable save button if result is ready
    const saveBtn = document.getElementById('btn-ocr-save-selected');
    if (saveBtn && multiOcrResults[engineId]?.status === 'ready') {
        saveBtn.disabled = false;
    }
}

/**
 * Save the selected OCR result
 */
async function saveSelectedOcrResult() {
    if (!selectedOcrEngine) {
        alert('Please select an OCR result to save.');
        return;
    }

    const result = multiOcrResults[selectedOcrEngine];
    if (!result || result.status !== 'ready') {
        alert('Selected OCR result is not ready.');
        return;
    }

    // Get the (possibly edited) text from the textarea
    const textarea = document.getElementById(`text-${selectedOcrEngine}`);
    const finalText = textarea ? textarea.value : result.text;

    const saveBtn = document.getElementById('btn-ocr-save-selected');
    saveBtn.disabled = true;
    saveBtn.textContent = '💾 Saving...';

    try {
        // Get selected level info
        const levelSelect = document.getElementById('level-select');
        const selectedLevel = levelSelect ? levelSelect.value : 'Level 1';
        const levelInfo = getSelectedLevelInfo();

        // Save the final result
        const response = await fetch('/api/ocr/save-multi-ocr-result', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                book_id: currentBookId,
                page_number: currentPage,
                selection_x: currentSelectionScaled.x,
                selection_y: currentSelectionScaled.y,
                selection_width: currentSelectionScaled.width,
                selection_height: currentSelectionScaled.height,
                image_data_base64: document.getElementById('cropped-image').src,
                ocr_text: finalText,
                confidence: result.confidence,
                ocr_engine: selectedOcrEngine,
                level: selectedLevel,
                selected_level_number: levelInfo.number,
                selected_level_text: levelInfo.text
            })
        });

        if (!response.ok) {
            const errorData = await response.json().catch(() => ({}));
            throw new Error(errorData.detail || `HTTP ${response.status}`);
        }

        const saveResult = await response.json();
        console.log('Multi-OCR save result:', saveResult);

        saveBtn.textContent = '✓ Saved!';

        // Reload clips gallery
        await loadRecentClips();

        // Close comparison section and clear selection after brief delay
        setTimeout(() => {
            cancelOcrComparison();
            clearSelection();
        }, 1000);

    } catch (error) {
        console.error('Error saving OCR result:', error);
        alert(`Save failed: ${error.message}`);
        saveBtn.textContent = '💾 Save Selected';
        saveBtn.disabled = false;
    }
}

/**
 * Cancel OCR comparison and hide the section
 */
function cancelOcrComparison() {
    const comparisonSection = document.getElementById('ocr-comparison-section');
    if (comparisonSection) {
        comparisonSection.classList.remove('visible');
    }

    // Reset state
    multiOcrResults = {
        'surya-600': { text: '', confidence: 0, status: 'waiting' },
        'surya-ds': { text: '', confidence: 0, status: 'waiting' },
        'tesseract': { text: '', confidence: 0, status: 'waiting' },
        'easyocr': { text: '', confidence: 0, status: 'waiting' }
    };
    selectedOcrEngine = null;
    multiOcrClipId = null;
    ocrCompletedCount = 0;

    // Reset save button
    const saveBtn = document.getElementById('btn-ocr-save-selected');
    if (saveBtn) {
        saveBtn.textContent = '💾 Save Selected';
        saveBtn.disabled = true;
    }

    // Deselect all boxes
    ['surya-600', 'surya-ds', 'tesseract', 'easyocr'].forEach(id => {
        const box = document.getElementById(`ocr-box-${id}`);
        if (box) box.classList.remove('selected');
    });
}

/**
 * Reset the multi-OCR comparison section
 */
function resetMultiOcrSection() {
    cancelOcrComparison();
}
