                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                book_id: currentBookId,
                diagram_id: currentDiagramId,
                description: newDescription
            })
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();
