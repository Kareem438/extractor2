/**
 * Verify Pages JavaScript
 * Displays raw page images side-by-side with raw knowledge units
 */

// State
let currentBookId = null;
let currentPage = 1;
let totalPages = 0;
let books = [];

// Selection state
let selectionCanvas = null;
let selectionCtx = null;
let sourceImage = null;
let isDrawing = false;
let startX = 0;
let startY = 0;
let currentSelection = null; // { x, y, width, height } - display coordinates
let currentSelectionScaled = null; // { x, y, width, height } - natural image coordinates

// Clips data for merge operations
let currentParagraphClips = [];
let currentDiagramClips = [];
let firstVisibleParagraphClipId = null;
let firstVisibleDiagramClipId = null;

// Mode state: 'select' or 'ocr'
let currentMode = 'ocr'; // Default to Clip + OCR mode

// OCR result state
let currentOcrResult = null;
let currentKnowledgeUnitId = null;
let ocrTextModified = false;

// Diagram analysis state
let currentDiagramResult = null;
let currentDiagramId = null;
let currentDiagramKuId = null;
let diagramDescriptionModified = false;
let pageKnowledgeUnits = []; // For linking dropdown

// Diagram details V3 state
let selectedDiagramKuId = null; // Currently selected KU for association
let diagramLevelTitles = { 1: '', 2: '', 3: '', 4: '', 5: '' }; // Level titles
let diagramImageData = null; // Store the diagram image for preview

// Selected level state (from radio buttons)
let selectedLevelNumber = null; // 1-5 or null if none selected

// Initialize on page load
document.addEventListener('DOMContentLoaded', () => {
    console.log('Verify Pages loaded');
    loadBooks();
    setupEventListeners();
    // Set default mode to Clip + OCR and update UI
    setMode('ocr');
    // Note: Surya OCR loading moved to on-demand when user first uses OCR
    // to avoid blocking page load. Call loadSuryaOCR() manually if needed.
});

// Get URL parameter by name
function getUrlParameter(name) {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get(name);
}

// Load level titles from URL parameters and pre-fill inputs
function loadTitlesFromURL() {
    console.log('=== loadTitlesFromURL() called ===');
    console.log('Current URL:', window.location.href);

    const level1 = getUrlParameter('level1');
    const level2 = getUrlParameter('level2');
    const level3 = getUrlParameter('level3');
    const level4 = getUrlParameter('level4');
    const level5 = getUrlParameter('level5');

    console.log('URL Parameters:', { level1, level2, level3, level4, level5 });

    // Check if any level title parameters exist and have non-empty values
    if (level1 || level2 || level3 || level4 || level5) {
        console.log('At least one level has a value, processing...');

        // Pre-fill the level title inputs (including level 5)
        for (let i = 1; i <= 5; i++) {
            const input = document.getElementById(`level-${i}-input`);
            console.log(`Level ${i} input element:`, input);

            if (input) {
                const levelValue = getUrlParameter(`level${i}`);
                console.log(`Level ${i} value from URL: "${levelValue}"`);

                // Only set if value exists and is not empty
                if (levelValue && levelValue.trim() !== '') {
                    console.log(`Setting level ${i} input to: "${levelValue}"`);
                    input.value = levelValue;
                    // Make the input visible
                    input.classList.add('visible');
                    // Show the save button
                    const saveBtn = document.getElementById(`btn-save-${i}`);
                    if (saveBtn) {
                        saveBtn.style.display = 'block';
                    }
                    // Also update the diagramLevelTitles object
                    diagramLevelTitles[i] = levelValue;
                    console.log(`Level ${i} input value after setting:`, input.value);
                } else {
                    console.log(`Level ${i} value is empty or null, skipping`);
                }
            } else {
                console.log(`Level ${i} input element not found in DOM`);
            }
        }

        console.log('Final diagramLevelTitles:', diagramLevelTitles);
    } else {
        console.log('No level parameters found in URL');
    }
}

// Batch update level titles for all paragraphs and diagrams on the current page
async function batchUpdateTitles() {
    if (!currentBookId || !currentPage) {
        alert('❌ Please select a book and load a page first');
        return;
    }

    const btn = document.getElementById('btn-batch-update-titles');
    if (!btn) return;

    const originalText = btn.textContent;
    btn.textContent = '⏳ Updating...';
    btn.disabled = true;

    try {
        // Collect level titles from the inputs
        const levelTitles = {};
        for (let i = 1; i <= 4; i++) {
            const input = document.getElementById(`level-${i}-input`);
            if (input) {
                levelTitles[`level_${i}_title`] = input.value.trim() || null;
            } else {
                // Use from diagramLevelTitles if input doesn't exist
                levelTitles[`level_${i}_title`] = diagramLevelTitles[i] || null;
            }
        }

        const response = await fetch('/api/update-page-level-titles', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                book_id: currentBookId,
                page_number: currentPage,
                ...levelTitles
            })
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log('Batch update result:', result);

        btn.textContent = `✓ Updated ${result.total_updated} items!`;
        setTimeout(() => {
            btn.textContent = originalText;
            btn.disabled = false;
        }, 2000);

        alert(`✅ Successfully updated titles for:\n- ${result.paragraphs_updated} paragraphs\n- ${result.diagrams_updated} diagrams\n\nTotal: ${result.total_updated} items on page ${currentPage}`);

    } catch (error) {
        console.error('Error in batch update:', error);
        alert(`❌ Batch update failed: ${error.message}`);
        btn.textContent = originalText;
        btn.disabled = false;
    }
}

// Setup event listeners
function setupEventListeners() {
    const bookSelect = document.getElementById('book-select');
    const pageInput = document.getElementById('page-input');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const loadBtn = document.getElementById('load-btn');
    const editParagraphsBtn = document.getElementById('edit-paragraphs-btn');
    const editDiagramsBtn = document.getElementById('edit-diagrams-btn');
    const reviewRawBtn = document.getElementById('review-raw-btn');

    bookSelect.addEventListener('change', (e) => {
        currentBookId = parseInt(e.target.value);
        if (currentBookId) {
            // Get total pages for selected book
            const book = books.find(b => b.book_id === currentBookId);
            if (book) {
                totalPages = book.total_pages;
                currentPage = 1;
                pageInput.value = 1;
                pageInput.max = totalPages;
                updatePageInfo();
                loadPage();
            }
        }
    });

    pageInput.addEventListener('change', (e) => {
        const page = parseInt(e.target.value);
        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            updatePageInfo();
        } else {
            e.target.value = currentPage;
        }
    });

    prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
            currentPage--;
            pageInput.value = currentPage;
            updatePageInfo();
            loadPage();
        }
    });

    nextBtn.addEventListener('click', () => {
        if (currentPage < totalPages) {
            currentPage++;
            pageInput.value = currentPage;
            updatePageInfo();
            loadPage();
        }
    });

    loadBtn.addEventListener('click', () => {
        if (currentBookId) {
            loadPage();
        }
    });

    // Enable Enter key on page input
    pageInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            currentPage = parseInt(e.target.value);
            updatePageInfo();
            loadPage();
        }
    });

    // Edit Paragraphs button - navigate to edit-paragraphs page with current book, page, and first visible clip
    editParagraphsBtn.addEventListener('click', () => {
        if (currentBookId) {
            let url = `/edit-paragraphs?book_id=${currentBookId}&page=${currentPage}`;
            if (firstVisibleParagraphClipId) {
                url += `&scroll_to=${firstVisibleParagraphClipId}`;
            }
            window.location.href = url;
        }
    });

    // Edit Diagrams button - navigate to edit-diagrams page with current book, page, and first visible clip
    if (editDiagramsBtn) {
        editDiagramsBtn.addEventListener('click', () => {
            if (currentBookId) {
                let url = `/edit-diagrams?book_id=${currentBookId}&page=${currentPage}`;
                if (firstVisibleDiagramClipId) {
                    url += `&scroll_to=${firstVisibleDiagramClipId}`;
                }
                window.location.href = url;
            }
        });
    }

    // Review Raw button - navigate to review-raw page with current book and page
    if (reviewRawBtn) {
        reviewRawBtn.addEventListener('click', () => {
            if (currentBookId) {
                window.location.href = `/review-raw?book_id=${currentBookId}`;
            }
        });
    }
}

// Load books list
async function loadBooks() {
    console.log('Loading books...');
    try {
        const response = await fetch('/api/books?limit=100');
        console.log('Books API response status:', response.status);

        const data = await response.json();
        console.log('Books data received:', data);

        books = data.books || [];
        console.log('Number of books:', books.length);

        const bookSelect = document.getElementById('book-select');

        if (books.length === 0) {
            bookSelect.innerHTML = '<option value="">No books available</option>';
            console.log('No books available');
            return;
        }

        bookSelect.innerHTML = '<option value="">Select a book...</option>' +
            books.map(book =>
                `<option value="${book.book_id}">${book.book_name} (${book.total_pages} pages)</option>`
            ).join('');

        console.log('Books loaded successfully');

        // Check if book_id was passed in URL (from library page or edit-paragraphs)
        const bookIdParam = getUrlParameter('book_id');
        const pageParam = getUrlParameter('page');

        if (bookIdParam) {
            const bookId = parseInt(bookIdParam);
            console.log('Book ID from URL:', bookId);

            // Find the book in the list
            const book = books.find(b => b.book_id === bookId);
            if (book) {
                // Set the dropdown to this book
                bookSelect.value = bookId;

                // Set state variables
                currentBookId = bookId;
                totalPages = book.total_pages;

                // Use page from URL parameter if provided, otherwise default to 1
                const initialPage = pageParam ? parseInt(pageParam) : 1;
                currentPage = Math.max(1, Math.min(initialPage, totalPages)); // Ensure within valid range

                // Update page input
                const pageInput = document.getElementById('page-input');
                pageInput.value = currentPage;
                pageInput.max = totalPages;

                // Update page info
                updatePageInfo();

                // Automatically load the page
                await loadPage();

                console.log(`Auto-selected book: ${book.book_name}, loading page ${currentPage}`);

                // Check for level title parameters from "Load Titles" feature (after page loads)
                loadTitlesFromURL();
            } else {
                console.warn(`Book ID ${bookId} not found in books list`);
            }
        }

    } catch (error) {
        console.error('Error loading books:', error);
        showError('image-panel', 'Failed to load books');
        showError('knowledge-units-panel', 'Failed to load books');
    }
}

// Update page info display
function updatePageInfo() {
    const pageInfo = document.getElementById('page-info');
    if (currentBookId && totalPages > 0) {
        pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
    } else {
        pageInfo.textContent = 'Select a book to start';
    }

    // Update button states
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const editParagraphsBtn = document.getElementById('edit-paragraphs-btn');
    const editDiagramsBtn = document.getElementById('edit-diagrams-btn');
    const reviewRawBtn = document.getElementById('review-raw-btn');

    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= totalPages;
    editParagraphsBtn.disabled = !currentBookId; // Enable when book is selected
    if (editDiagramsBtn) {
        editDiagramsBtn.disabled = !currentBookId; // Enable when book is selected
    }
    if (reviewRawBtn) {
        reviewRawBtn.disabled = !currentBookId; // Enable when book is selected
    }
}

// Load page data
async function loadPage() {
    if (!currentBookId) {
        showError('image-panel', 'Please select a book first');
        return;
    }

    // Show loading state
    showLoading('image-panel');

    // Clear selection when loading new page, but preserve level titles
    clearSelection(true); // preserveLevels = true

    try {
        const response = await fetch(`/api/verify-pages/${currentBookId}?page_number=${currentPage}`);

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const data = await response.json();

        // Display image with selection canvas
        displayImage(data);

        // Load recent clips for this page
        loadRecentClips();

    } catch (error) {
        console.error('Error loading page:', error);
        showError('image-panel', `Failed to load page: ${error.message}`);
    }
}

// Display page image
function displayImage(data) {
    const imagePanel = document.getElementById('image-panel');

    if (!data.image_base64) {
        imagePanel.innerHTML = `
            <div class="empty-state">
                <h2>📄 No Image Data</h2>
                <p>Page ${data.page_number} has not been scanned yet.</p>
            </div>
        `;
        return;
    }

    const imageSrc = `data:image/${data.image_format || 'png'};base64,${data.image_base64}`;

    imagePanel.innerHTML = `
        <div class="image-container">
            <div class="image-wrapper">
                <img id="source-image" src="${imageSrc}" alt="Page ${data.page_number}" />
                <canvas id="selection-canvas"></canvas>
            </div>
            <div class="selection-info" id="selection-info" style="display: none;">
                Click and drag to select an area
            </div>
        </div>
    `;

    // Wait for image to load, then setup canvas
    const img = document.getElementById('source-image');
    img.onload = () => {
        setupSelectionCanvas(img);
    };
}

// Display knowledge units
function displayKnowledgeUnits(knowledgeUnits) {
    const kuPanel = document.getElementById('knowledge-units-panel');

    if (!knowledgeUnits || knowledgeUnits.length === 0) {
        kuPanel.innerHTML = `
            <div class="empty-state">
                <h2>📝 No Knowledge Units</h2>
                <p>This page has not been processed by any OCR engine yet.</p>
            </div>
        `;
        return;
    }

    const kuHtml = knowledgeUnits.map(ku => createKnowledgeUnitHtml(ku)).join('');

    kuPanel.innerHTML = `<div class="knowledge-units">${kuHtml}</div>`;
}

// Create knowledge unit HTML
function createKnowledgeUnitHtml(ku) {
    const confidence = ku.confidence_score !== null ? (ku.confidence_score * 100).toFixed(1) : 'N/A';
    const confidenceClass = getConfidenceClass(ku.confidence_score);
    const timestamp = ku.ocr_run_timestamp ? new Date(ku.ocr_run_timestamp).toLocaleString() : 'Unknown';

    return `
        <div class="knowledge-unit">
            <div class="ku-header">
                <div class="ku-engine">${getEngineIcon(ku.ocr_engine)} ${ku.ocr_engine}</div>
                <div class="ku-confidence ${confidenceClass}">
                    Confidence: ${confidence}%
                </div>
            </div>
            <div class="ku-text">${escapeHtml(ku.full_page_text || '(No text extracted)')}</div>
            <div class="ku-meta">
                <span>📏 Length: ${ku.text_length || 0} chars</span>
                <span>🌐 Language: ${ku.language || 'Unknown'}</span>
                <span>🕒 Processed: ${timestamp}</span>
            </div>
        </div>
    `;
}

// Get engine icon
function getEngineIcon(engine) {
    const icons = {
        'easyocr': '🔵',
        'surya': '🟠',
        'tesseract': '🟢',
        'paddleocr': '🔴'
    };
    const engineLower = (engine || '').toLowerCase();
    return icons[engineLower] || '⚙️';
}

// Get confidence class
function getConfidenceClass(confidence) {
    if (confidence === null) return '';
    if (confidence >= 0.8) return 'confidence-high';
    if (confidence >= 0.5) return 'confidence-medium';
    return 'confidence-low';
}

// Show loading state
function showLoading(panelId) {
    const panel = document.getElementById(panelId);
    panel.innerHTML = `
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading...</p>
        </div>
    `;
}

// Show error state
function showError(panelId, message) {
    const panel = document.getElementById(panelId);
    panel.innerHTML = `
        <div class="empty-state">
            <h2>⚠️ Error</h2>
            <p>${escapeHtml(message)}</p>
        </div>
    `;
}

// Escape HTML
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// ============================================================================
// Rectangle Selection Functionality
// ============================================================================

// Setup selection canvas overlay
function setupSelectionCanvas(img) {
    sourceImage = img;
    selectionCanvas = document.getElementById('selection-canvas');
    selectionCtx = selectionCanvas.getContext('2d');

    // Match canvas size to image size
    selectionCanvas.width = img.width;
    selectionCanvas.height = img.height;

    // Add mouse event listeners
    selectionCanvas.addEventListener('mousedown', onMouseDown);
    selectionCanvas.addEventListener('mousemove', onMouseMove);
    selectionCanvas.addEventListener('mouseup', onMouseUp);
    selectionCanvas.addEventListener('mouseleave', onMouseLeave);

    // Setup crop action buttons
    setupCropButtons();

    console.log('Selection canvas setup complete:', { width: img.width, height: img.height });
}

// Mouse down - start drawing
function onMouseDown(e) {
    const rect = selectionCanvas.getBoundingClientRect();
    startX = e.clientX - rect.left;
    startY = e.clientY - rect.top;
    isDrawing = true;

    // Show selection info
    const selectionInfo = document.getElementById('selection-info');
    if (selectionInfo) {
        selectionInfo.style.display = 'block';
        selectionInfo.textContent = 'Drawing selection...';
    }
}

// Mouse move - update rectangle
function onMouseMove(e) {
    if (!isDrawing) return;

    const rect = selectionCanvas.getBoundingClientRect();
    const currentX = e.clientX - rect.left;
    const currentY = e.clientY - rect.top;

    // Clear canvas
    selectionCtx.clearRect(0, 0, selectionCanvas.width, selectionCanvas.height);

    // Draw rectangle
    const width = currentX - startX;
    const height = currentY - startY;

    // Get selection colors based on current mode
    const colors = getSelectionColor();

    // Draw semi-transparent rectangle (color depends on mode)
    selectionCtx.fillStyle = colors.fill;
    selectionCtx.fillRect(startX, startY, width, height);

    // Draw border
    selectionCtx.strokeStyle = colors.stroke;
    selectionCtx.lineWidth = 2;
    selectionCtx.strokeRect(startX, startY, width, height);

    // Update selection info
    const selectionInfo = document.getElementById('selection-info');
    if (selectionInfo) {
        selectionInfo.textContent = `Size: ${Math.abs(width).toFixed(0)} × ${Math.abs(height).toFixed(0)} px`;
    }
}

// Mouse up - finalize selection
function onMouseUp(e) {
    if (!isDrawing) return;
    isDrawing = false;

    const rect = selectionCanvas.getBoundingClientRect();
    const endX = e.clientX - rect.left;
    const endY = e.clientY - rect.top;

    // Calculate normalized selection (handle negative width/height)
    const x = Math.min(startX, endX);
    const y = Math.min(startY, endY);
    const width = Math.abs(endX - startX);
    const height = Math.abs(endY - startY);

    // Only save if selection has meaningful size
    if (width > 5 && height > 5) {
        currentSelection = { x, y, width, height };
        console.log('Selection saved:', currentSelection);

        // Crop and display selected area
        cropAndDisplaySelection();

        // Update selection info
        const selectionInfo = document.getElementById('selection-info');
        if (selectionInfo) {
            selectionInfo.textContent = `Selected: ${width.toFixed(0)} × ${height.toFixed(0)} px`;
        }
    } else {
        // Selection too small, clear it
        clearSelection();
    }
}

// Mouse leave - cancel drawing
function onMouseLeave() {
    if (isDrawing) {
        isDrawing = false;
        selectionCtx.clearRect(0, 0, selectionCanvas.width, selectionCanvas.height);
    }
}

// Crop and display the selected area
function cropAndDisplaySelection() {
    if (!currentSelection || !sourceImage) return;

    const { x, y, width, height } = currentSelection;

    // Calculate scale ratio between natural (actual) image size and displayed size
    const scaleX = sourceImage.naturalWidth / sourceImage.width;
    const scaleY = sourceImage.naturalHeight / sourceImage.height;

    console.log('Image dimensions:', {
        displayed: { width: sourceImage.width, height: sourceImage.height },
        natural: { width: sourceImage.naturalWidth, height: sourceImage.naturalHeight },
        scale: { scaleX, scaleY }
    });

    // Scale the selection coordinates to match the natural image size
    const scaledX = Math.round(x * scaleX);
    const scaledY = Math.round(y * scaleY);
    const scaledWidth = Math.round(width * scaleX);
    const scaledHeight = Math.round(height * scaleY);

    // Store scaled coordinates for API submission
    currentSelectionScaled = {
        x: scaledX,
        y: scaledY,
        width: scaledWidth,
        height: scaledHeight
    };

    // Create a temporary canvas to crop the image at natural size
    const cropCanvas = document.createElement('canvas');
    cropCanvas.width = scaledWidth;
    cropCanvas.height = scaledHeight;
    const cropCtx = cropCanvas.getContext('2d');

    // Draw the selected portion of the image using scaled coordinates
    cropCtx.drawImage(
        sourceImage,
        scaledX, scaledY, scaledWidth, scaledHeight,  // Source rectangle (natural size)
        0, 0, scaledWidth, scaledHeight   // Destination rectangle (natural size)
    );

    // Convert to data URL
    const croppedImageData = cropCanvas.toDataURL('image/png');

    // Display in right panel
    const croppedDisplay = document.getElementById('cropped-image-display');
    croppedDisplay.innerHTML = `
        <img src="${croppedImageData}" alt="Selected area" id="cropped-image" />
    `;

    // Enable action buttons
    document.getElementById('add-paragraph-btn').disabled = false;
    document.getElementById('add-diagram-btn').disabled = false;
    document.getElementById('clear-selection-btn').disabled = false;

    console.log('Cropped image displayed at natural size:', currentSelectionScaled);
}

// Setup crop button handlers
function setupCropButtons() {
    // Add as paragraph
    const addParagraphBtn = document.getElementById('add-paragraph-btn');
    if (addParagraphBtn) {
        addParagraphBtn.onclick = () => saveImageClip('paragraph');
    }

    // Add as diagram
    const addDiagramBtn = document.getElementById('add-diagram-btn');
    if (addDiagramBtn) {
        addDiagramBtn.onclick = () => saveImageClip('diagram');
    }

    // Clear selection
    const clearBtn = document.getElementById('clear-selection-btn');
    if (clearBtn) {
        clearBtn.onclick = clearSelection;
    }
}

// Save image clip to database
async function saveImageClip(clipType) {
    if (!currentSelection || !currentSelectionScaled || !currentBookId) return;

    const croppedImage = document.getElementById('cropped-image');
    if (!croppedImage) return;

    // Get the selected level
    const levelSelect = document.getElementById('level-select');
    const selectedLevel = levelSelect ? levelSelect.value : 'Level 1';

    // Check if we're in OCR mode
    const isOcrModeForParagraph = currentMode === 'ocr' && clipType === 'paragraph';
    const isOcrModeForDiagram = currentMode === 'ocr' && clipType === 'diagram';

    try {
        // Show saving indicator
        const btn = clipType === 'paragraph'
            ? document.getElementById('add-paragraph-btn')
            : document.getElementById('add-diagram-btn');

        const originalText = btn.textContent;

        if (isOcrModeForParagraph) {
            btn.textContent = '🔍 Running OCR...';
        } else if (isOcrModeForDiagram) {
            btn.textContent = '🤖 Analyzing...';
        } else {
            btn.textContent = '💾 Saving...';
        }
        btn.disabled = true;

        if (isOcrModeForParagraph) {
            // In OCR mode for paragraph: Run multi-OCR comparison
            const ocrResult = await runMultiOcrComparison();

            if (ocrResult) {
                // Don't clear selection - keep it so user can see the OCR results and choose
                console.log('Multi-OCR started, keeping selection for comparison');
            }
        } else if (isOcrModeForDiagram) {
            // In OCR mode for diagram: Run full diagram analysis (OCR + Claude Vision)
            const diagramResult = await runDiagramAnalysis();

            if (diagramResult) {
                // Reload recent clips to show the new one
                await loadRecentClips();

                // Don't clear selection - keep it so user can see the analysis result and edit
                console.log('Diagram analysis completed, keeping selection for editing');
            }
        } else {
            // In Select mode: Just save the image (existing behavior)
            // Get selected level info from radio buttons
            const levelInfo = getSelectedLevelInfo();

            // Prepare request data (use scaled coordinates - natural image size)
            const requestData = {
                book_id: currentBookId,
                page_number: currentPage,
                clip_type: clipType,
                selection_x: currentSelectionScaled.x,
                selection_y: currentSelectionScaled.y,
                selection_width: currentSelectionScaled.width,
                selection_height: currentSelectionScaled.height,
                image_data_base64: croppedImage.src,  // Already in base64 format
                image_format: 'png',
                level: selectedLevel,  // Include selected level (dropdown)
                selected_level_number: levelInfo.number,  // From radio button
                selected_level_text: levelInfo.text  // Text of selected level
            };

            // Save to database
            const response = await fetch('/api/save-image-clip', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestData)
            });

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();
            console.log('Clip saved:', result);

            // Reload recent clips to show the new one
            await loadRecentClips();

            // Clear the selection
            clearSelection();
        }

    } catch (error) {
        console.error('Error saving clip:', error);
        alert(`❌ Failed to save image: ${error.message}`);
    } finally {
        // Restore button
        const btn = clipType === 'paragraph'
            ? document.getElementById('add-paragraph-btn')
            : document.getElementById('add-diagram-btn');

        btn.textContent = clipType === 'paragraph' ? '📝 Add as Paragraph' : '📊 Add as Diagram';
        btn.disabled = false;
    }
}

// Clear selection
// preserveLevels: if true, keep the level extraction titles (used when changing pages)
function clearSelection(preserveLevels = false) {
    currentSelection = null;
    currentSelectionScaled = null;
    isDrawing = false;

    // Clear canvas
    if (selectionCtx) {
        selectionCtx.clearRect(0, 0, selectionCanvas.width, selectionCanvas.height);
    }

    // Clear cropped image display
    const croppedDisplay = document.getElementById('cropped-image-display');
    if (croppedDisplay) {
        croppedDisplay.innerHTML = `
            <div class="empty-state">
                <h2>🖼️ No Selection</h2>
                <p>Click and drag on the left image to select an area.</p>
            </div>
        `;
    }

    // Disable action buttons
    document.getElementById('add-paragraph-btn').disabled = true;
    document.getElementById('add-diagram-btn').disabled = true;
    document.getElementById('clear-selection-btn').disabled = true;

    // Hide selection info
    const selectionInfo = document.getElementById('selection-info');
    if (selectionInfo) {
        selectionInfo.style.display = 'none';
    }

    // Reset OCR section
    resetOcrSection();

    // Reset diagram sections
    resetDiagramSections();

    // Only reset level extraction if not preserving levels (i.e., when user explicitly clears)
    if (!preserveLevels) {
        resetLevelExtraction();
    }

    console.log('Selection cleared' + (preserveLevels ? ' (levels preserved)' : ''));
}

// ============================================================================
// Recent Clips Gallery Functions
// ============================================================================

// Load recent image clips from database
async function loadRecentClips() {
    if (!currentBookId) return;

    try {
        // Load all recent clips from the book (not filtered by page)
        const response = await fetch(`/api/recent-image-clips/${currentBookId}?limit=5`);

        if (!response.ok) {
            console.error('Failed to load recent clips');
            return;
        }

        const data = await response.json();
        console.log('Recent clips loaded:', data);

        // Display the clips
        displayRecentClips(data.paragraph_clips, data.diagram_clips);

    } catch (error) {
        console.error('Error loading recent clips:', error);
    }
}

// Display recent clips in the thumbnail gallery
function displayRecentClips(paragraphClips, diagramClips) {
    // Store clips globally for merge operations
    currentParagraphClips = paragraphClips || [];
    currentDiagramClips = diagramClips || [];

    // Store first visible paragraph clip ID for navigation to edit-paragraphs
    firstVisibleParagraphClipId = (currentParagraphClips && currentParagraphClips.length > 0)
        ? currentParagraphClips[0].id
        : null;

    // Store first visible diagram clip ID for navigation to edit-diagrams
    firstVisibleDiagramClipId = (currentDiagramClips && currentDiagramClips.length > 0)
        ? currentDiagramClips[0].id
        : null;

    // Display paragraph clips (newest at top, with merge buttons between)
    const paragraphThumbnails = document.getElementById('paragraph-thumbnails');
    if (paragraphClips && paragraphClips.length > 0) {
        paragraphThumbnails.innerHTML = createThumbnailsWithMergeButtons(paragraphClips, 'paragraph');
    } else {
        paragraphThumbnails.innerHTML = '<div class="empty-thumbnails">No clips yet</div>';
    }

    // Display diagram clips (newest at top, with merge buttons between)
    const diagramThumbnails = document.getElementById('diagram-thumbnails');
    if (diagramClips && diagramClips.length > 0) {
        diagramThumbnails.innerHTML = createThumbnailsWithMergeButtons(diagramClips, 'diagram');
    } else {
        diagramThumbnails.innerHTML = '<div class="empty-thumbnails">No clips yet</div>';
    }
}

// Create thumbnails with merge buttons between them
function createThumbnailsWithMergeButtons(clips, type) {
    let html = '';

    clips.forEach((clip, index) => {
        // Add thumbnail
        html += createThumbnailHtml(clip, type, index);

        // Add merge button between thumbnails (not after the last one)
        if (index < clips.length - 1) {
            html += createMergeButtonHtml(type, index);
        }
    });

    return html;
}

// Create thumbnail HTML for a clip (at 30% scale)
function createThumbnailHtml(clip, type, index) {
    const imageSrc = `data:image/${clip.image_format};base64,${clip.image_data_base64}`;
    const timestamp = new Date(clip.created_at).toLocaleTimeString();

    return `
        <div class="thumbnail-item" id="${type}-clip-${index}" data-clip-id="${clip.id}" title="Page ${clip.page_number} - ${timestamp}">
            <div style="width: 30%; margin: 0 auto;">
                <img src="${imageSrc}" alt="${type} clip" />
            </div>
            <div class="thumbnail-info">
                <span>Page ${clip.page_number}</span>
                <span>${timestamp}</span>
            </div>
        </div>
    `;
}

// Create merge button HTML between two thumbnails
function createMergeButtonHtml(type, topIndex) {
    return `
        <div class="merge-button-container">
            <button class="btn-merge" onclick="mergeClips('${type}', ${topIndex}, ${topIndex + 1})">
                ⬇️ Merge ⬇️
            </button>
        </div>
    `;
}

// Merge two adjacent clips into one
async function mergeClips(type, index1, index2) {
    // Get the clips array
    const clips = type === 'paragraph' ? currentParagraphClips : currentDiagramClips;

    if (!clips || index1 >= clips.length || index2 >= clips.length) {
        alert('❌ Invalid clip indices');
        return;
    }

    const clip1 = clips[index1];
    const clip2 = clips[index2];

    console.log('Merging clips:', { type, clip1, clip2 });

    try {
        // Load both images
        const img1 = await loadImageFromBase64(`data:image/${clip1.image_format};base64,${clip1.image_data_base64}`);
        const img2 = await loadImageFromBase64(`data:image/${clip2.image_format};base64,${clip2.image_data_base64}`);

        // Create canvas to combine images vertically
        const maxWidth = Math.max(img1.width, img2.width);
        const totalHeight = img1.height + img2.height;

        const mergeCanvas = document.createElement('canvas');
        mergeCanvas.width = maxWidth;
        mergeCanvas.height = totalHeight;
        const mergeCtx = mergeCanvas.getContext('2d');

        // Fill with white background
        mergeCtx.fillStyle = 'white';
        mergeCtx.fillRect(0, 0, maxWidth, totalHeight);

        // Draw first image at top (centered if narrower)
        const x1 = (maxWidth - img1.width) / 2;
        mergeCtx.drawImage(img1, x1, 0);

        // Draw second image below first (centered if narrower)
        const x2 = (maxWidth - img2.width) / 2;
        mergeCtx.drawImage(img2, x2, img1.height);

        // Convert to base64
        const mergedImageData = mergeCanvas.toDataURL('image/png');

        // Calculate combined selection area (use clip1's page and position, extend height)
        const mergedSelection = {
            x: clip1.selection_x,
            y: clip1.selection_y,
            width: maxWidth,
            height: totalHeight
        };

        // Save merged clip with the display_order of the first clip
        const requestData = {
            book_id: currentBookId,
            page_number: clip1.page_number, // Use first clip's page
            clip_type: type,
            selection_x: mergedSelection.x,
            selection_y: mergedSelection.y,
            selection_width: mergedSelection.width,
            selection_height: mergedSelection.height,
            image_data_base64: mergedImageData,
            image_format: 'png',
            description: `Merged from clips ${clip1.id} and ${clip2.id}`,
            display_order: clip1.display_order  // Inherit display_order from first clip
        };

        // Save merged clip to database
        const saveResponse = await fetch('/api/save-image-clip', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(requestData)
        });

        if (!saveResponse.ok) {
            throw new Error(`Failed to save merged clip: ${saveResponse.statusText}`);
        }

        const saveResult = await saveResponse.json();
        console.log('Merged clip saved:', saveResult);

        // Disable the two original clips (mark as is_enabled = FALSE)
        await disableImageClip(type, clip1.id);
        await disableImageClip(type, clip2.id);

        // Reload clips to show the merged result
        await loadRecentClips();

        alert('✅ Clips merged successfully!');

    } catch (error) {
        console.error('Error merging clips:', error);
        alert(`❌ Failed to merge clips: ${error.message}`);
    }
}

// Helper function to load image from base64
function loadImageFromBase64(src) {
    return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = src;
    });
}

// Disable an image clip (mark as is_enabled = FALSE)
async function disableImageClip(type, clipId) {
    const response = await fetch(`/api/disable-image-clip/${type}/${clipId}`, {
        method: 'PATCH'
    });

    if (!response.ok) {
        throw new Error(`Failed to disable clip ${clipId}`);
    }

    return await response.json();
}

// Delete an image clip (permanently remove)
async function deleteImageClip(type, clipId) {
    const response = await fetch(`/api/delete-image-clip/${type}/${clipId}`, {
        method: 'DELETE'
    });

    if (!response.ok) {
        throw new Error(`Failed to delete clip ${clipId}`);
    }

    return await response.json();
}

// Level extraction state - stores knowledge unit IDs for each level
let levelKnowledgeUnitIds = {};

/**
 * Handle level radio button change
 */
function onLevelRadioChange(levelNumber) {
    selectedLevelNumber = levelNumber;

    // Update row highlighting
    for (let i = 1; i <= 5; i++) {
        const row = document.getElementById(`level-row-${i}`);
        if (row) {
            if (i === levelNumber) {
                row.classList.add('selected');
            } else {
                row.classList.remove('selected');
            }
        }
    }

    // Update indicator
    const indicator = document.getElementById('selected-level-indicator');
    const numberSpan = document.getElementById('selected-level-number');
    if (indicator && numberSpan) {
        numberSpan.textContent = levelNumber;
        indicator.classList.add('visible');
    }

    console.log(`Selected level: ${levelNumber}`);
}

/**
 * Get the currently selected level info (number and text)
 */
function getSelectedLevelInfo() {
    if (!selectedLevelNumber) {
        return { number: null, text: null };
    }

    const input = document.getElementById(`level-${selectedLevelNumber}-input`);
    const text = input ? input.value.trim() : '';

    return {
        number: selectedLevelNumber,
        text: text || null
    };
}

/**
 * Reset level selection (radio buttons)
 */
function resetLevelSelection() {
    selectedLevelNumber = null;

    // Uncheck all radio buttons
    for (let i = 1; i <= 5; i++) {
        const radio = document.getElementById(`level-radio-${i}`);
        const row = document.getElementById(`level-row-${i}`);
        if (radio) radio.checked = false;
        if (row) row.classList.remove('selected');
    }

    // Hide indicator
    const indicator = document.getElementById('selected-level-indicator');
    if (indicator) {
        indicator.classList.remove('visible');
    }
}

// Extract level function - runs OCR on current selection and shows result
async function extractLevel(levelNumber) {
    const inputElement = document.getElementById(`level-${levelNumber}-input`);
    const saveButton = document.getElementById(`btn-save-${levelNumber}`);
    const extractButton = document.getElementById(`btn-extract-${levelNumber}`);

    if (!inputElement) {
        console.error(`Level ${levelNumber} input not found`);
        return;
    }

    // Check if we have a selection
    if (!currentSelection || !currentSelectionScaled || !currentBookId) {
        alert('Please select an area on the image first');
        return;
    }

    const croppedImage = document.getElementById('cropped-image');
    if (!croppedImage) {
        alert('Please select an area on the image first');
        return;
    }

    // Show the input field and update extract button
    inputElement.classList.add('visible');
    extractButton.textContent = '⏳ OCR...';
    extractButton.disabled = true;
    inputElement.value = 'Running Surya OCR...';
    inputElement.disabled = true;

    try {
        // Prepare request data
        const requestData = {
            book_id: currentBookId,
            page_number: currentPage,
            selection_x: currentSelectionScaled.x,
            selection_y: currentSelectionScaled.y,
            selection_width: currentSelectionScaled.width,
            selection_height: currentSelectionScaled.height,
            image_data_base64: croppedImage.src,
            level: `Level ${levelNumber}`
        };

        console.log(`Extracting Level ${levelNumber} with OCR...`);

        // Call the OCR endpoint
        const response = await fetch('/api/ocr/surya-clip', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(requestData)
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.detail || `HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log(`Level ${levelNumber} OCR result:`, result);

        // Store the knowledge unit ID for saving
        levelKnowledgeUnitIds[levelNumber] = result.knowledge_unit_id;

        // Update UI with extracted text
        inputElement.value = result.ocr_text || '';
        inputElement.disabled = false;

        // Show save button
        saveButton.style.display = 'inline-block';
        saveButton.textContent = '💾 Save';
        saveButton.classList.remove('saved');

        // Reset extract button
        extractButton.textContent = '🔍 Extract';
        extractButton.disabled = false;

        // Focus on input for editing
        inputElement.focus();

    } catch (error) {
        console.error(`Level ${levelNumber} extraction error:`, error);
        inputElement.value = `Error: ${error.message}`;
        inputElement.disabled = false;
        extractButton.textContent = '🔍 Extract';
        extractButton.disabled = false;
    }
}

// Save level text function - saves edited text to database
async function saveLevelText(levelNumber) {
    const inputElement = document.getElementById(`level-${levelNumber}-input`);
    const saveButton = document.getElementById(`btn-save-${levelNumber}`);

    if (!inputElement) {
        console.error(`Level ${levelNumber} input not found`);
        return;
    }

    const newText = inputElement.value;
    const knowledgeUnitId = levelKnowledgeUnitIds[levelNumber];

    // If no OCR knowledge unit (loaded from URL), just update the internal state
    if (!knowledgeUnitId) {
        // Update the diagramLevelTitles object
        diagramLevelTitles[levelNumber] = newText;

        // Show success feedback
        saveButton.textContent = '✓ Saved';
        saveButton.classList.add('saved');
        saveButton.disabled = false;

        // Reset button text after a delay
        setTimeout(() => {
            saveButton.textContent = '💾 Save';
            saveButton.classList.remove('saved');
        }, 2000);

        console.log(`Level ${levelNumber} title updated in memory:`, newText);
        return;
    }

    // Original functionality: Save OCR extracted text to knowledge unit
    try {
        saveButton.textContent = '⏳...';
        saveButton.disabled = true;

        const response = await fetch('/api/ocr/update-clip-text', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                book_id: currentBookId,
                knowledge_unit_id: knowledgeUnitId,
                text: newText
            })
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log(`Level ${levelNumber} text saved:`, result);

        // Update button to show saved state
        saveButton.textContent = '✓ Saved';
        saveButton.classList.add('saved');
        saveButton.disabled = false;

        // Reset button text after a delay
        setTimeout(() => {
            saveButton.textContent = '💾 Save';
            saveButton.classList.remove('saved');
        }, 2000);

    } catch (error) {
        console.error(`Error saving Level ${levelNumber} text:`, error);
        saveButton.textContent = '✗ Error';
        saveButton.disabled = false;

        setTimeout(() => {
            saveButton.textContent = '💾 Save';
        }, 2000);
    }
}

// Reset level extraction section
function resetLevelExtraction() {
    // Clear all level inputs and hide save buttons
    for (let i = 1; i <= 5; i++) {
        const inputElement = document.getElementById(`level-${i}-input`);
        const saveButton = document.getElementById(`btn-save-${i}`);
        const extractButton = document.getElementById(`btn-extract-${i}`);

        if (inputElement) {
            inputElement.value = '';
            inputElement.classList.remove('visible');
            inputElement.disabled = false;
        }
        if (saveButton) {
            saveButton.style.display = 'none';
            saveButton.textContent = '💾 Save';
            saveButton.classList.remove('saved');
        }
        if (extractButton) {
            extractButton.textContent = '🔍 Extract';
            extractButton.disabled = false;
        }
    }

    // Clear stored knowledge unit IDs
    levelKnowledgeUnitIds = {};
}

// Load Surya OCR models on page load
async function loadSuryaOCR() {
    const statusMessage = document.getElementById('surya-status-message');
    const messageText = document.getElementById('surya-message-text');

    if (!statusMessage || !messageText) {
        console.error('Surya status message element not found');
        return;
    }

    // Show loading message
    messageText.textContent = '⏳ Loading Surya OCR on GPU... (this may take 10-15 seconds)';
    statusMessage.classList.add('visible', 'loading');

    console.log('Starting Surya OCR load...');

    try {
        const response = await fetch('/api/ocr/load-surya');
        const data = await response.json();

        console.log('Surya OCR load response:', data);

        if (response.ok && data.status === 'success') {
            // Success - show green message (stays until user closes it)
            messageText.textContent = '✅ ' + data.message;
            statusMessage.classList.remove('loading', 'error');
            statusMessage.classList.add('visible');

            console.log('Surya OCR loaded successfully');
        } else {
            // Error (stays until user closes it)
            messageText.textContent = '❌ ' + (data.message || 'Failed to load Surya OCR');
            statusMessage.classList.remove('loading');
            statusMessage.classList.add('visible', 'error');

            console.error('Failed to load Surya OCR:', data.message);
        }
    } catch (error) {
        // Network or other error (stays until user closes it)
        messageText.textContent = '❌ Error loading Surya OCR: ' + error.message;
        statusMessage.classList.remove('loading');
        statusMessage.classList.add('visible', 'error');

        console.error('Error loading Surya OCR:', error);
    }
}

// Close Surya OCR status message
function closeSuryaMessage() {
    const statusMessage = document.getElementById('surya-status-message');
    if (statusMessage) {
        statusMessage.classList.remove('visible');
    }
}

// ============================================================================
// Mode Switching Functions (Select vs Clip+OCR)
// ============================================================================

/**
 * Set the current mode ('select' or 'ocr')
 * @param {string} mode - 'select' or 'ocr'
 */
function setMode(mode) {
    currentMode = mode;

    const selectBtn = document.getElementById('mode-select-btn');
    const ocrBtn = document.getElementById('mode-ocr-btn');
    const modeIndicator = document.getElementById('mode-indicator');
    const rightPanelHeader = document.getElementById('right-panel-header');
    const selectionInfo = document.getElementById('selection-info');
    const ocrResultSection = document.getElementById('ocr-result-section');

    if (mode === 'select') {
        // Select Only mode
        selectBtn.classList.add('active-select');
        selectBtn.classList.remove('');
        ocrBtn.classList.remove('active-ocr');

        modeIndicator.textContent = 'Select Mode';
        modeIndicator.classList.add('select-mode');
        modeIndicator.classList.remove('ocr-mode');

        rightPanelHeader.textContent = '✂️ Selected Area';
        rightPanelHeader.classList.remove('ocr-mode');

        // Hide OCR result section
        if (ocrResultSection) {
            ocrResultSection.classList.remove('visible');
        }

        // Update selection info style
        if (selectionInfo) {
            selectionInfo.classList.remove('ocr-mode');
        }

        // Update canvas style
        if (selectionCanvas) {
            selectionCanvas.classList.remove('ocr-mode');
        }

        console.log('Switched to Select Only mode');
    } else if (mode === 'ocr') {
        // Clip + OCR mode
        selectBtn.classList.remove('active-select');
        ocrBtn.classList.add('active-ocr');

        modeIndicator.textContent = 'Clip + OCR Mode';
        modeIndicator.classList.remove('select-mode');
        modeIndicator.classList.add('ocr-mode');

        rightPanelHeader.textContent = '✂️ Selected Area';
        rightPanelHeader.classList.add('ocr-mode');

        // Update selection info style
        if (selectionInfo) {
            selectionInfo.classList.add('ocr-mode');
        }

        // Update canvas style
        if (selectionCanvas) {
            selectionCanvas.classList.add('ocr-mode');
        }

        console.log('Switched to Clip + OCR mode');
    }
}

/**
 * Get the current selection color based on mode
 */
function getSelectionColor() {
    if (currentMode === 'ocr') {
        return {
            fill: 'rgba(76, 175, 80, 0.2)',   // Green for OCR mode
            stroke: '#4CAF50'
        };
    } else {
        return {
            fill: 'rgba(33, 150, 243, 0.2)',  // Blue for Select mode
            stroke: '#2196F3'
        };
    }
}

// ============================================================================
// OCR Functions for Clip+OCR Mode
// ============================================================================

/**
 * Run Surya OCR on the current cropped selection
 * Called when user clicks "Add as Paragraph" in OCR mode
 */
async function runSuryaOcrOnClip() {
    const croppedImage = document.getElementById('cropped-image');
    if (!croppedImage || !currentSelectionScaled || !currentBookId) {
        console.error('Missing required data for OCR');
        return null;
    }

    const ocrStatus = document.getElementById('ocr-status');
    const ocrResultSection = document.getElementById('ocr-result-section');
    const ocrTextArea = document.getElementById('ocr-text-area');
    const ocrConfidence = document.getElementById('ocr-confidence');
    const btnSaveOcr = document.getElementById('btn-save-ocr');
    const ocrSaveStatus = document.getElementById('ocr-save-status');

    // Show OCR section and set processing status
    ocrResultSection.classList.add('visible');
    ocrStatus.textContent = 'Processing...';
    ocrStatus.classList.add('processing');
    ocrStatus.classList.remove('error');
    ocrTextArea.value = '';
    ocrTextArea.disabled = true;
    btnSaveOcr.disabled = true;
    ocrSaveStatus.textContent = '';
    ocrConfidence.textContent = 'Confidence: --';

    // Get the selected level
    const levelSelect = document.getElementById('level-select');
    const selectedLevel = levelSelect ? levelSelect.value : 'Level 1';

    try {
        // Prepare request data
        const requestData = {
            book_id: currentBookId,
            page_number: currentPage,
            selection_x: currentSelectionScaled.x,
            selection_y: currentSelectionScaled.y,
            selection_width: currentSelectionScaled.width,
            selection_height: currentSelectionScaled.height,
            image_data_base64: croppedImage.src,
            level: selectedLevel
        };

        console.log('Sending OCR request:', { ...requestData, image_data_base64: '[BASE64_DATA]' });

        // Call the OCR endpoint
        const response = await fetch('/api/ocr/surya-clip', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(requestData)
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.detail || `HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log('OCR result:', result);

        // Update UI with results
        ocrStatus.textContent = 'Complete';
        ocrStatus.classList.remove('processing', 'error');

        ocrTextArea.value = result.ocr_text || '';
        ocrTextArea.disabled = false;

        // Show confidence
        const confidencePercent = (result.confidence * 100).toFixed(1);
        ocrConfidence.textContent = `Confidence: ${confidencePercent}%`;

        // Store result for later
        currentOcrResult = result;
        currentKnowledgeUnitId = result.knowledge_unit_id;
        ocrTextModified = false;

        // Enable save button and show saved status
        btnSaveOcr.disabled = false;
        ocrSaveStatus.textContent = '✓ Auto-saved';
        ocrSaveStatus.classList.add('saved');
        ocrSaveStatus.classList.remove('unsaved');

        // Setup text change listener
        ocrTextArea.addEventListener('input', onOcrTextChanged);

        return result;

    } catch (error) {
        console.error('OCR error:', error);

        ocrStatus.textContent = 'Error';
        ocrStatus.classList.remove('processing');
        ocrStatus.classList.add('error');

        ocrTextArea.value = `Error: ${error.message}`;
        ocrTextArea.disabled = true;
        btnSaveOcr.disabled = true;

        return null;
    }
}

/**
 * Handle OCR text changes
 */
function onOcrTextChanged() {
    ocrTextModified = true;
    const ocrSaveStatus = document.getElementById('ocr-save-status');
    const btnSaveOcr = document.getElementById('btn-save-ocr');

    ocrSaveStatus.textContent = '● Unsaved changes';
    ocrSaveStatus.classList.remove('saved');
    ocrSaveStatus.classList.add('unsaved');
    btnSaveOcr.disabled = false;
}

/**
 * Save edited OCR text to database
 */
async function saveOcrText() {
    if (!currentKnowledgeUnitId || !currentBookId) {
        console.error('No knowledge unit ID to save');
        return;
    }

    const ocrTextArea = document.getElementById('ocr-text-area');
    const ocrSaveStatus = document.getElementById('ocr-save-status');
    const btnSaveOcr = document.getElementById('btn-save-ocr');

    const newText = ocrTextArea.value;

    try {
        btnSaveOcr.disabled = true;
        ocrSaveStatus.textContent = 'Saving...';

        const response = await fetch(`/api/ocr/update-clip-text`, {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                book_id: currentBookId,
                knowledge_unit_id: currentKnowledgeUnitId,
                text: newText
            })
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log('Text saved:', result);

        ocrSaveStatus.textContent = '✓ Saved';
        ocrSaveStatus.classList.add('saved');
        ocrSaveStatus.classList.remove('unsaved');
        ocrTextModified = false;

    } catch (error) {
        console.error('Error saving OCR text:', error);
        ocrSaveStatus.textContent = '✗ Save failed';
        ocrSaveStatus.classList.remove('saved');
        ocrSaveStatus.classList.add('unsaved');
        btnSaveOcr.disabled = false;
    }
}

/**
 * Reset OCR result section
 */
function resetOcrSection() {
    const ocrResultSection = document.getElementById('ocr-result-section');
    const ocrTextArea = document.getElementById('ocr-text-area');
    const ocrStatus = document.getElementById('ocr-status');
    const ocrConfidence = document.getElementById('ocr-confidence');
    const ocrSaveStatus = document.getElementById('ocr-save-status');
    const btnSaveOcr = document.getElementById('btn-save-ocr');

    if (ocrResultSection) {
        ocrResultSection.classList.remove('visible');
    }
    if (ocrTextArea) {
        ocrTextArea.value = '';
        ocrTextArea.disabled = true;
    }
    if (ocrStatus) {
        ocrStatus.textContent = 'Ready';
        ocrStatus.classList.remove('processing', 'error');
    }
    if (ocrConfidence) {
        ocrConfidence.textContent = 'Confidence: --';
    }
    if (ocrSaveStatus) {
        ocrSaveStatus.textContent = '';
    }
    if (btnSaveOcr) {
        btnSaveOcr.disabled = true;
    }

    currentOcrResult = null;
    currentKnowledgeUnitId = null;
    ocrTextModified = false;
}

// ============================================================================
// Diagram Analysis Functions
// ============================================================================

/**
 * Run diagram analysis (Surya OCR + Claude Vision) on the current selection
 * Called when user clicks "Add as Diagram" in OCR mode
 */
async function runDiagramAnalysis() {
    const croppedImage = document.getElementById('cropped-image');
    if (!croppedImage || !currentSelectionScaled || !currentBookId) {
        console.error('Missing required data for diagram analysis');
        return null;
    }

    // Use the new V3 diagram details section elements
    const diagramDetailsSection = document.getElementById('diagram-details-section');
    const aiStatusBadge = document.getElementById('diagram-ai-status-badge');
    const aiTextarea = document.getElementById('diagram-ai-textarea');

    // Show the diagram details section immediately with processing status
    if (diagramDetailsSection) {
        diagramDetailsSection.classList.add('visible');
    }
    if (aiStatusBadge) {
        aiStatusBadge.textContent = 'Analyzing...';
        aiStatusBadge.classList.add('processing');
        aiStatusBadge.classList.remove('error');
    }
    if (aiTextarea) {
        aiTextarea.value = 'Running Claude Vision analysis...';
    }

    // Set preview image immediately
    const previewImage = document.getElementById('diagram-preview-image');
    const previewInfo = document.getElementById('diagram-preview-info');
    if (previewImage) {
        previewImage.src = croppedImage.src;
    }
    if (previewInfo && currentSelectionScaled) {
        previewInfo.innerHTML = `
            <div>Size: ${currentSelectionScaled.width} x ${currentSelectionScaled.height} px</div>
            <div>Format: PNG</div>
            <div>Page: ${currentPage}</div>
        `;
    }

    // Get the selected level
    const levelSelect = document.getElementById('level-select');
    const selectedLevel = levelSelect ? levelSelect.value : 'Level 1';

    try {
        // Prepare request data
        const requestData = {
            book_id: currentBookId,
            page_number: currentPage,
            selection_x: currentSelectionScaled.x,
            selection_y: currentSelectionScaled.y,
            selection_width: currentSelectionScaled.width,
            selection_height: currentSelectionScaled.height,
            image_data_base64: croppedImage.src,
            level: selectedLevel,
            use_claude: true,
            use_surya: true
        };

        console.log('Sending diagram analysis request:', { ...requestData, image_data_base64: '[BASE64_DATA]' });

        // Call the diagram analysis endpoint
        const response = await fetch('/api/ocr/analyze-diagram', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(requestData)
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.detail || `HTTP ${response.status}`);
        }

        const result = await response.json();
        console.log('Diagram analysis result:', result);

        // Store result for later
        currentDiagramResult = result;
        currentDiagramId = result.diagram_id;
        currentDiagramKuId = result.knowledge_unit_id;
        diagramDescriptionModified = false;

        // Update the V3 diagram details section with results
        if (aiStatusBadge) {
            aiStatusBadge.textContent = '✓ Complete';
            aiStatusBadge.classList.remove('processing', 'error');
        }
        if (aiTextarea) {
            aiTextarea.value = result.description || '';
        }

        // Load KU list for associated text section
        loadKUsForDiagramDetails();

        return result;

    } catch (error) {
        console.error('Diagram analysis error:', error);

        if (aiStatusBadge) {
            aiStatusBadge.textContent = 'Error';
            aiStatusBadge.classList.remove('processing');
            aiStatusBadge.classList.add('error');
        }
        if (aiTextarea) {
            aiTextarea.value = `Error: ${error.message}`;
        }

        return null;
    }
}

/**
 * Handle diagram description changes
 */
function onDiagramDescriptionChanged() {
    diagramDescriptionModified = true;
    const diagramSaveStatus = document.getElementById('diagram-save-status');
    const btnSaveDiagram = document.getElementById('btn-save-diagram');

    diagramSaveStatus.textContent = '● Unsaved changes';
    diagramSaveStatus.classList.remove('saved');
    diagramSaveStatus.classList.add('unsaved');
    btnSaveDiagram.disabled = false;
}

