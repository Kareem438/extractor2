# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_extraction

# Tesseract OCR Path
TESSERACT_PATH=/usr/bin/tesseract

# Model Cache Directory
MODEL_CACHE_DIR=/mnt/h/12-extractor/models

# Server Configuration
HOST=0.0.0.0
PORT=7777

# Logging
LOG_LEVEL=INFO
LOG_FILE=/mnt/h/12-extractor/logs/app.log

# Vector Database
CHROMA_PERSIST_DIR=/mnt/h/12-extractor/chroma_db

# Anthropic API (Claude Vision for diagram analysis)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here
