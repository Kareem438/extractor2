\par This script demonstrates how to use }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7423329\charrsid7423329 OpenRouter}{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7423329\charrsid7423329  (for Qwen) and }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 
\b\insrsid7423329\charrsid7423329 DeepSeek}{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7423329\charrsid7423329  (for R1) together.\~
\par python
\par import os
\par from openai import OpenAI # OpenRouter & DeepSeek use OpenAI-compatible clients
\par 
\par # 1. Setup Clients
\par qwen_client = OpenAI(
\par     base_url="https://openrouter.ai",
\par     api_key="YOUR_OPENROUTER_KEY"
\par )
\par 
\par deepseek_client = OpenAI(
\par     base_url="https://api.deepseek.com",
\par     api_key="YOUR_DEEPSEEK_KEY"
\par )
\par 
\par def process_page(image_url):
\par     # STEP 1: Extract Text with Qwen 2.5-VL (Vision)
\par     # Note: Arabic OCR is highly accurate with the 72B model
\par     extraction = qwen_client.chat.completions.create(
\par         model="qwen/qwen-2.5-vl-72b-instruct",
\par         messages=[
\par             \{
\par                 "role": "user",
\par                 "content": [
\par                     \{"type": "text", "text": "Transcribe the Arabic text in this document exactly as it appears, preserving headers and tables in Markdown."\},
\par                     }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \lang1031\langfe1033\langnp1031\insrsid7423329\charrsid7423329 \{"type": "image_url", "image_url": \{"url": image_url\}\}
\par                 }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7423329\charrsid7423329 ]
\par             \}
\par         ]
\par     )
\par     raw_text = extraction.choices[0].message.content
\par 
\par     # STEP 2: Deep Research with DeepSeek-R1
\par     # Note: We pass the extracted text, not the image
\par     analysis = deepseek_client.chat.completions.create(
\par         model="deepseek-reasoner",
\par         messages=[
\par             \{"role": "system", "content": "You are an expert researcher. Perform 5 distinct searches to verify the following text."\},
\par             \{"role": "user", "content": f"Analyze this text: \\n\\n \{raw_text\}"\}
\par         ]
\par     )
\par     
\par     return analysis.choices[0].message.content
