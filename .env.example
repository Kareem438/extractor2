# CHUNK-044: Configuration Files

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_extraction

# Tesseract OCR Path
TESSERACT_PATH=/usr/bin/tesseract

# Model Cache Directory
MODEL_CACHE_DIR=./models

# OpenAI API Key (optional, for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional, for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Vision API credentials (optional, for Google Vision OCR)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-vision-key.json

# Server Configuration
HOST=0.0.0.0
PORT=7777

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Vector Database
CHROMA_PERSIST_DIR=./chroma_db

# Processing Settings (defaults)
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_CHUNK_SIZE_MIN=100
DEFAULT_CHUNK_SIZE_MAX=500
DEFAULT_OVERLAP_SIZE=50
DEFAULT_CHECKPOINT_FREQUENCY=10
