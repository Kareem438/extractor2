  "common_patterns": {
    "database_access": {
      "pattern": "Use SQLAlchemy session with try/finally",
      "example": "db = SessionLocal(); try: ... finally: db.close()"
    },
    "error_handling": {
      "pattern": "Use custom exceptions, log errors",
      "example": "except OCRError as e: logger.error(f'OCR failed: {e}'); raise"
    },
    "configuration": {
      "pattern": "Import settings from src.config",
      "example": "from src.config import settings; db_url = settings.DATABASE_URL"
    },
    "logging": {
      "pattern": "Get logger at module level",
      "example": "logger = logging.getLogger(__name__)"
    },
    "async_functions": {
      "pattern": "Use async/await for FastAPI endpoints",
      "example": "async def upload_file(file: UploadFile): ..."
